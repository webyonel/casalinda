---
/**
 * FabButton.astro · Botón flotante con contador del pedido.
 * Se muestra solo cuando hay productos seleccionados.
 */
---
<button class="fab" id="fab" aria-label="Ver pedido" hidden>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M6 7h12l-1.2 11.2A2 2 0 0 1 14.8 20H9.2a2 2 0 0 1-2-1.8L6 7z"/>
    <path d="M9 7V5a3 3 0 0 1 6 0v2"/>
  </svg>
  <span>Ver pedido</span>
  <span class="fab-count" id="fabCount">0</span>
</button>
