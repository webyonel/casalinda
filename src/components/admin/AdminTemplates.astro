---
/**
 * AdminTemplates.astro · <template>s reutilizables para clonar en el shell.
 * El shell hace cloneNode(true) del firstElementChild de cada template.
 */
---

<!-- ============== Template: card de producto ============== -->
<template id="tpl-product-card">
  <article class="admin-card" data-id="">
    <div class="admin-card-media">
      <span class="admin-card-status">Disponible</span>
      <span class="admin-card-badge">Agotado</span>
    </div>
    <div class="admin-card-body">
      <span class="admin-card-cat"></span>
      <h3 class="admin-card-name"></h3>
      <p class="admin-card-price"></p>
      <div class="admin-card-foot">
        <label class="admin-card-toggle">
          <span class="admin-card-toggle-label">Disponible</span>
          <input type="checkbox" data-toggle="" />
          <span class="switch" aria-hidden="true"></span>
        </label>
        <div class="admin-card-actions">
          <button class="admin-btn" data-edit="" type="button" aria-label="Editar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </button>
          <button class="admin-btn is-danger" data-delete="" type="button" aria-label="Eliminar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      </div>
    </div>
  </article>
</template>
