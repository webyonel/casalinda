---
/**
 * Overlays.astro · Toast y diálogo de confirmación.
 * IDs: #toast, #confirmDialog, #confirmMsg.
 */
---
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<dialog id="confirmDialog" class="confirm-dialog" aria-labelledby="confirmMsg">
  <div class="confirm-dialog-body">
    <h3 id="confirmTitle">¿Confirmas esta acción?</h3>
    <p id="confirmMsg">—</p>
  </div>
  <div class="confirm-dialog-actions">
    <button type="button" class="btn btn-ghost btn-sm" data-confirm-cancel>Cancelar</button>
    <button type="button" class="btn btn-danger btn-sm" data-confirm-ok>Confirmar</button>
  </div>
</dialog>
